{
  "name": "erilea-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:navegador": "playwright test -c tests/navegador/playwright.config.ts",
    "golden:referencia": "node tests/navegador/executar.mjs golden-referencia",
    "mestre:atualizar": "node tests/navegador/executar.mjs mestre",
    "portao": "node scripts/portao.mjs",
    "publicar": "node scripts/publicar.mjs",
    "hooks:instalar": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pinia": "^4.1.0",
    "simplex-noise": "^4.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
